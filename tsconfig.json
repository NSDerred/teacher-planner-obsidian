{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    // Explicit lib: the default for target ES2018 omits ES2019+, so Array.flatMap
    // typed as `any` and leaked unsafe-any warnings. Only the type library moves —
    // target stays ES2018, so emitted syntax is unchanged.
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": true,
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte"
  ],
  "exclude": ["node_modules"]
}
